# ==============================================================================
# SciTrace AI — Environment Variables Configuration
# ==============================================================================

# Supabase API Configuration (Safe for Frontend / Public)
# Obtain these from Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_anon_or_publishable_key
# Alternatively supported key name:
# VITE_SUPABASE_ANON_KEY=sb_publishable_your_anon_or_publishable_key

# Backend API Configuration (FastAPI - Step 3)
VITE_API_BASE_URL=http://localhost:8000/api
VITE_USE_MOCK=true

# ==============================================================================
# SECURITY NOTICE:
# NEVER put SUPABASE_SERVICE_ROLE_KEY in this file or any file with VITE_ prefix!
# Service-role keys bypass Row Level Security and must only be stored on the
# secure FastAPI backend server.
# ==============================================================================
