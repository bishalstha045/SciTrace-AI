# ==============================================================================
# SciTrace AI — Backend Environment Variables
# File: backend/.env.example
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Supabase Configuration
# Required for connecting to the Supabase database and storage
# Obtained from: Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Key (or Publishable Key)
# Used for client-level queries or verifying auth sessions
SUPABASE_KEY=your-supabase-anon-or-publishable-key

# Supabase Service Role Key (OPTIONAL for development, REQUIRED for admin operations)
# WARNING: NEVER expose this key in frontend code or check it into Git!
# Obtained from: Supabase Dashboard -> Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# JWT Secret for offline token validation (Optional)
# Obtained from: Supabase Dashboard -> Project Settings -> API -> JWT Secret
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Upload & File Constraints
MAX_FILE_SIZE_BYTES=52428800  # 50 MB
ALLOWED_FILE_TYPES=application/pdf

# Testing Mode
# Set to true only in automated test suites to allow test token bypass
ALLOW_TEST_AUTH=false
